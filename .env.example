# Copy this file to `.env` and edit as needed. All values are optional.

# --- Optional proxy (leave commented to use this machine's normal IP) ---
# PROXY_SERVER=http://host:port
# PROXY_USERNAME=your_user
# PROXY_PASSWORD=your_pass

# --- Default number of result pages to scrape (override on the CLI with --pages) ---
MAX_PAGES=5

# --- PostgreSQL (required for db.seed) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/company_scraper

# --- OpenAI (required for LLM-powered industry/location normalization) ---
# OPENAI_API_KEY=sk-...
